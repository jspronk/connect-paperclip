{
  "manifest_version": 3,
  "name": "Connect Paperclip",
  "version": "0.1.0",
  "description": "Hover definitions from the AWS docs for Amazon Connect metrics, columns and permissions, plus links to flows and routing profiles.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.my.connect.aws/*",
    "https://*.awsapps.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Connect Paperclip",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/*"
      ],
      "js": [
        "src/content/main.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
