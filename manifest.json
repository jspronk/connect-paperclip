{
  "manifest_version": 3,
  "name": "Connect Metrics Helper",
  "version": "0.1.0",
  "description": "Hover any metric label on the Amazon Connect Customer admin website to see its official AWS definition.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.my.connect.aws/*",
    "https://*.awsapps.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Connect Metrics Helper",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.my.connect.aws/*",
        "https://*.awsapps.com/*"
      ],
      "js": [
        "src/content/main.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
