{
  "name": "connect-paperclip",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that adds hover definitions, sourced from the AWS docs, to metric labels on the Amazon Connect Customer admin website.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:fetch": "tsx scripts/fetch-docs.ts",
    "docs:build": "tsx scripts/build-metrics.ts",
    "docs:update": "npm run docs:fetch && npm run docs:build",
    "icons": "tsx scripts/render-icons.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
